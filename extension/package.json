{
	"name": "@hackdrop/extension",
	"version": "0.2.2",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"package": "pnpm build && web-ext build --source-dir=dist --artifacts-dir=web-ext-artifacts --overwrite-dest",
		"lint:webext": "web-ext lint --source-dir=dist",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"preact": "^11.1.0"
	},
	"devDependencies": {
		"@preact/preset-vite": "^2.10.6",
		"@preact/signals": "^2.11.4",
		"@tailwindcss/vite": "^4.3.3",
		"@types/chrome": "^0.3.6",
		"@types/firefox-webext-browser": "^143.0.1",
		"@types/node": "catalog:",
		"tailwindcss": "^4.3.3",
		"typescript": "catalog:",
		"vite": "^8.3.5",
		"web-ext": "^10.8.0"
	}
}
