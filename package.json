{
	"name": "hackdrop",
	"version": "0.2.1",
	"description": "A modernized new-tab extension showing GitHub Trending and Hacker News, with auto theme.",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm -r --parallel --stream dev",
		"build": "pnpm -r build",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt --check",
		"fmt:fix": "oxfmt",
		"release": "node scripts/release.mjs"
	},
	"devDependencies": {
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"oxlint-tsgolint": "^7.0.2005",
		"typescript": "catalog:"
	},
	"packageManager": "pnpm@10.34.9",
	"engines": {
		"node": ">=24"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"@tailwindcss/oxide"
		],
		"overrides": {
			"ajv@<6.14.0": "^6.14.0",
			"ajv@>=7 <8.18.0": "^8.18.0",
			"uuid@<14.0.0": "^14.0.0"
		}
	}
}
