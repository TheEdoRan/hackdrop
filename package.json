{
	"name": "hackdrop",
	"version": "0.2.2",
	"description": "A modernized new-tab extension showing GitHub Trending and Hacker News, with auto theme.",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm -r --parallel --stream dev",
		"build": "pnpm -r build",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt --check",
		"fmt:fix": "oxfmt",
		"release": "node scripts/release.mjs"
	},
	"devDependencies": {
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"oxlint-tsgolint": "^7.0.2005",
		"typescript": "catalog:"
	},
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=24"
	}
}
